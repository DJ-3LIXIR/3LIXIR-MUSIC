{
  "version": 2,
  "builds": [
    {
      "src": "api/send-receipt-email.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/send-receipt-email",
      "dest": "/api/send-receipt-email.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.cjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/tools/stem-splitter",
      "dest": "/index.html",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
